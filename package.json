{
  "name": "blog-studio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @blog/web dev",
    "build": "pnpm --filter @blog/web build",
    "start": "pnpm --filter @blog/web start",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "pnpm -r test",
    "validate": "pnpm --filter @blog/web validate"
  }
}
